# Supabase project — Settings ▸ API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose to the browser: it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bucket holding capture masters. Create it as a PRIVATE bucket.
NEXT_PUBLIC_CAPTURE_BUCKET=captures

# Shared secret for POST /api/assignments/run (the 7am job).
CAPTURE_CRON_SECRET=change-me

# Largest single upload accepted, in bytes. 512 MB covers ~60s of 4K.
NEXT_PUBLIC_MAX_UPLOAD_BYTES=536870912

# --- OneDrive / SharePoint export (optional) -------------------------------
# Leave unset and POST /api/review/push-to-onedrive answers 501 rather than
# failing oddly. See the README for the app registration steps.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Target drive: GET /sites/{host}:/sites/{site}:/drives with Graph Explorer.
MS_DRIVE_ID=
MS_EXPORT_FOLDER=Student captures

# Safety reports POST here as {"text": "..."} — a Slack or Teams incoming
# webhook works as-is. Unset, reports still land in safety_flags and the audit
# log; they just do not page anyone.
SAFETY_ALERT_WEBHOOK_URL=
