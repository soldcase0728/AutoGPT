# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://olsm:olsm@localhost:5432/olsm_facilities?schema=public"
APP_URL="http://localhost:3000"
# 32+ random bytes, base64. Rotate by setting SESSION_SECRET_PREVIOUS during rollover.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
TZ="America/Detroit"

# ---------------------------------------------------------------------------
# Microsoft Entra ID SSO (internal staff) and Microsoft Graph (outbound mail)
#
# One app registration in the OLSM tenant covers both. The tenant id makes the
# authority tenant-specific, which is what refuses personal Microsoft accounts
# and other tenants before a token is issued -- see DEPLOY.md for the setup.
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Guest accounts live in the tenant too, and a guest is not an employee. Empty
# means tenant membership alone decides.
ENTRA_ALLOWED_DOMAINS="olsm.edu"
# Optional, for tenants managing this with existing security groups instead of
# app roles: "<group-object-id>=FACILITY_ADMIN,<group-object-id>=FINANCE"
ENTRA_GROUP_ROLE_MAP=""

# The one mailbox this application sends as. Set EMAIL_PROVIDER=graph to use it.
GRAPH_SENDER_MAILBOX="facilities@olsm.edu"

# ---------------------------------------------------------------------------
# Google Workspace SSO (internal staff)
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Only accounts on these domains may sign in via SSO. Comma separated.
GOOGLE_ALLOWED_DOMAINS="olsm.edu"

# ---------------------------------------------------------------------------
# Google Calendar (service account with domain-wide delegation)
# One calendar per facility; IDs are stored on the Facility row.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# PEM private key. Escape newlines as \n when set through a hosting dashboard.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# The Workspace user the service account impersonates (calendar owner).
GOOGLE_CALENDAR_IMPERSONATE_USER=""
# Shared secret echoed back on Google push notifications.
GOOGLE_CALENDAR_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# E-signature: "docusign" | "dropbox_sign" | "manual"
# "manual" keeps the full document state machine but records signatures in-app.
# ---------------------------------------------------------------------------
ESIGN_PROVIDER="manual"
DOCUSIGN_BASE_URI=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_PRIVATE_KEY=""
DROPBOX_SIGN_API_KEY=""
ESIGN_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Notifications: EMAIL_PROVIDER = "graph" | "sendgrid" | "postmark" | "console"
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="console"
EMAIL_FROM="athletics@olsm.edu"
SENDGRID_API_KEY=""
POSTMARK_SERVER_TOKEN=""

SMS_PROVIDER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---------------------------------------------------------------------------
# File storage for signed PDFs and certificates of insurance
# STORAGE_PROVIDER = "s3" | "gcs" | "local"
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_LOCAL_DIR="./.storage"

# ---------------------------------------------------------------------------
# Scheduled jobs. Cron hits /api/jobs/<name> with this bearer token.
# ---------------------------------------------------------------------------
JOB_RUNNER_TOKEN="change-me"
