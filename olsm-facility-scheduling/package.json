{
  "name": "olsm-facility-scheduling",
  "version": "0.1.0",
  "private": true,
  "description": "Facility reservation, liability and revenue capture system for Orchard Lake St. Mary's Preparatory athletics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "e2e": "npm run e2e:setup && playwright test",
    "e2e:setup": "node scripts/e2e-setup.mjs",
    "e2e:server": "node scripts/e2e-server.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.4",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrule": "2.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.4",
    "dotenv": "17.4.2",
    "postcss": "8.5.24",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
